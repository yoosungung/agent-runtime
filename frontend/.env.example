# Frontend env (copy to frontend/.env.local for local dev)
# Chat invoke goes to Ingress `/v1/agents/` → Envoy (not BFF `/api/chat/invoke`).
VITE_AGENTS_INVOKE_URL=/v1/agents/invoke
# Vite dev proxy target when using ./scripts/wire-dev.sh up (Envoy port-forward)
VITE_DEV_ENVOY_PROXY_TARGET=http://127.0.0.1:8084

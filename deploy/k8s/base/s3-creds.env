# Sync with deploy/k8s/garage/garage-secrets.env (GK* / bucket must match).
BUNDLE_STORAGE_BACKEND=s3
S3_BUCKET=runtime-bundles
S3_ENDPOINT_URL=http://garage-s3.garage.svc.cluster.local:3900
S3_REGION=garage
S3_PREFIX=bundles/
S3_ACCESS_KEY_ID=GKdev000000000000000001
S3_SECRET_ACCESS_KEY=devsecret000000000000000000000000000000000000000000000000000000
